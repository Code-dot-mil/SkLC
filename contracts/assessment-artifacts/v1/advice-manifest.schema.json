{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:assessment-artifacts:advice-manifest:v1",
  "title": "Assessment Advice Artifact Manifest v1",
  "type": "object",
  "required": ["schema_version", "advice_path", "advice_sha256", "skills", "assessors", "native_reports"],
  "properties": {
    "schema_version": { "const": "skill-exchange-assessment-advice-artifacts/v1" },
    "advice_path": { "const": "advice.md" },
    "advice_sha256": { "$ref": "#/$defs/sha256" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillName" },
      "uniqueItems": true
    },
    "assessors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assessorId" },
      "uniqueItems": true
    },
    "native_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_name", "assessor_id", "path", "sha256"],
        "properties": {
          "skill_name": { "$ref": "#/$defs/skillName" },
          "assessor_id": { "$ref": "#/$defs/assessorId" },
          "path": { "$ref": "#/$defs/nativeReportPath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "assessorId": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$" },
    "nativeReportPath": {
      "type": "string",
      "pattern": "^native/[a-z0-9](?:[a-z0-9-]{0,62})/[a-z0-9](?:[a-z0-9-]{0,62})/[a-f0-9]{64}\\.json$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "skillName": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$" }
  }
}
