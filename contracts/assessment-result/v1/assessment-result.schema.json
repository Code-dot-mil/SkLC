{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:assessment-result:v1",
  "title": "Assessment Result v1",
  "type": "object",
  "required": ["schema_version", "skill", "assessor", "normalized", "native", "completed_at"],
  "properties": {
    "schema_version": { "const": "skill-exchange-assessment-result/v1" },
    "skill": {
      "type": "object",
      "required": ["namespace", "skill_id", "content_hash"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "assessor": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "normalized": {
      "type": "object",
      "required": ["risk", "reason", "confidence_flags"],
      "properties": {
        "risk": { "$ref": "#/$defs/risk" },
        "reason": { "type": "string", "minLength": 1 },
        "confidence_flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/hexSha256" }
      },
      "additionalProperties": false
    },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "risk": { "enum": ["Low", "Medium", "High", "Unknown"] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "hexSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
