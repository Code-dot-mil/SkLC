{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:boe:v1",
  "title": "Bill of Evidence Manifest v1",
  "type": "object",
  "required": ["schema_version", "skill", "assessments"],
  "properties": {
    "schema_version": { "const": "skill-exchange-boe/v1" },
    "skill": {
      "type": "object",
      "required": ["name", "content_sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/skillName" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/assessmentPath" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "assessmentPath": {
      "type": "string",
      "pattern": "^assessments/[a-z0-9](?:[a-z0-9-]{0,62})/[a-f0-9]{64}\\.json$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "skillName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"
    }
  }
}
