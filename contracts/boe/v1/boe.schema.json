{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:boe:v1",
  "title": "Bill of Evidence v1",
  "type": "object",
  "required": ["schema_version", "skill", "assessment", "artifacts", "provenance"],
  "properties": {
    "schema_version": { "const": "skill-exchange-boe/v1" },
    "skill": {
      "type": "object",
      "required": ["namespace", "skill_id", "content_hash"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "source_revision": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["assessor", "mode", "scan_cache_key", "completed_at", "risk", "reason", "confidence_flags"],
      "properties": {
        "assessor": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "mode": { "type": "string", "minLength": 1 },
        "scan_cache_key": { "type": "string", "minLength": 1 },
        "completed_at": { "type": "string", "format": "date-time" },
        "risk": { "$ref": "#/$defs/risk" },
        "reason": { "type": "string", "minLength": 1 },
        "confidence_flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["native_report", "summary", "assessor_config", "hashes"],
      "properties": {
        "native_report": { "$ref": "#/$defs/relativePath" },
        "summary": { "$ref": "#/$defs/relativePath" },
        "assessor_config": { "$ref": "#/$defs/relativePath" },
        "hashes": { "$ref": "#/$defs/relativePath" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["assessment_kit_version"],
      "properties": {
        "assessment_kit_version": { "type": "string", "minLength": 1 },
        "pipeline_id": { "type": ["string", "null"] },
        "job_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "risk": { "enum": ["Low", "Medium", "High", "Unknown"] },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
