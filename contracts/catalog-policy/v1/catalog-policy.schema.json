{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:catalog-policy:v1",
  "title": "Skill Catalog Release Policy v1",
  "type": "object",
  "required": ["schema_version", "mode", "skills"],
  "properties": {
    "schema_version": { "const": "skill-exchange-catalog-policy/v1" },
    "mode": { "enum": ["include-list", "exclude-list"] },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62})$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
