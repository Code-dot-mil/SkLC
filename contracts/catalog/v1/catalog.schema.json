{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:catalog:v1",
  "title": "Skill Catalog Manifest v1",
  "type": "object",
  "required": ["schema_version", "catalog_id", "release_version", "created_at", "contracts", "policy", "skills"],
  "properties": {
    "schema_version": { "const": "skill-exchange-catalog/v1" },
    "catalog_id": { "type": "string", "minLength": 1 },
    "release_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "contracts": {
      "type": "object",
      "required": ["skill_package", "boe"],
      "properties": {
        "skill_package": { "type": "string", "minLength": 1 },
        "boe": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["schema_version", "digest"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/catalogEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "catalogEntry": {
      "type": "object",
      "required": ["namespace", "skill_id", "content_hash", "skill_path", "boe_path", "normalized_risk"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "skill_path": { "$ref": "#/$defs/relativePath" },
        "boe_path": { "$ref": "#/$defs/relativePath" },
        "normalized_risk": { "enum": ["Low", "Medium", "High", "Unknown"] }
      },
      "additionalProperties": false
    }
  }
}
