{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-exchange:skill-package:v1",
  "title": "Skill Package Metadata v1",
  "type": "object",
  "required": ["name", "description"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "properties": {
        "ai4sdlc.namespace": { "type": "string", "minLength": 1 },
        "ai4sdlc.category": { "type": "string", "minLength": 1 },
        "ai4sdlc.tags": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          ]
        },
        "ai4sdlc.owner": { "type": "string", "minLength": 1 },
        "ai4sdlc.upstream_url": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
