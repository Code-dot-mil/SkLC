{
  "name": "sklc-development",
  "private": true,
  "scripts": {
    "markdown:lint": "markdownlint-cli2",
    "markdown:check": "prettier --check \"**/*.md\" --ignore-path .gitignore --ignore-path .prettierignore",
    "markdown:format": "prettier --write \"**/*.md\" --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10"
  }
}
