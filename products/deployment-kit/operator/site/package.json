{
  "scripts": {
    "prebuild": "node scripts/copy-downloads.mjs",
    "build": "astro build",
    "dev": "astro dev --host 127.0.0.1",
    "lint": "npm run typecheck",
    "lint:code": "eslint .",
    "typecheck:astro": "astro check",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:coverage": "c8 node --test tests/*.test.mjs",
    "coverage:summary": "c8 report --reporter=text-summary"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/react": "^7.1.8",
    "astro": "^7.4.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "c8": "^12.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "c8": {
    "all": true,
    "include": [
      "src/lib/**/*.mjs",
      "scripts/**/*.mjs"
    ],
    "reporter": [
      "text",
      "html",
      "lcovonly",
      "json-summary"
    ]
  }
}
