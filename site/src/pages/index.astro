---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillCatalog from "../components/SkillCatalog";
import { exchangeIndex as index } from "../lib/exchange-data.mjs";
---

<BaseLayout title="Skill Exchange">
  <header class="header">
    <h1>Skill Exchange</h1>
    <p class="muted">Browse assessed skills with scanner-backed recommendations.</p>
    <p class="muted">
      Skills are reusable capabilities that follow the{" "}
      <a class="external-link" href="https://agentskills.io/home" target="_blank" rel="noreferrer" referrerpolicy="no-referrer">
        agentskills.io open standard <span aria-hidden="true">↗</span>
      </a>.
      Each one packages a <code>SKILL.md</code> file with metadata and instructions, plus optional scripts, references, assets, and other resources an AI agent can load when a task calls for them.
    </p>
  </header>
  <SkillCatalog client:load skills={index.skills} />
</BaseLayout>
