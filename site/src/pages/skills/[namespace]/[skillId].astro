---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import RecommendationBadge from "../../../components/RecommendationBadge.astro";
import ScannerFindings from "../../../components/ScannerFindings";
import { createMarkdownProcessor, parseFrontmatter } from "@astrojs/markdown-remark";
import { visit } from "unist-util-visit";
import index from "../../../../../.exchange/generated/index.json";
import scannerRunsTable from "../../../../../.exchange/generated/tables/scanner_runs.json";
import scannerFindingsTable from "../../../../../.exchange/generated/tables/scanner_findings.json";
import scannerArtifactsTable from "../../../../../.exchange/generated/tables/scanner_artifacts.json";

export function getStaticPaths() {
  return index.skills.map((skill) => ({
    params: { namespace: skill.namespace, skillId: skill.skill_id },
    props: { skill },
  }));
}

const { skill } = Astro.props;
const scannerRuns = scannerRunsTable.rows
  .filter((row) => row.namespace === skill.namespace && row.skill_id === skill.skill_id)
  .sort((left, right) => Date.parse(right.last_scanned || "") - Date.parse(left.last_scanned || ""));
const scannerRunIds = new Set(scannerRuns.map((run) => run.id));
const scannerFindings = scannerFindingsTable.rows.filter((row) => scannerRunIds.has(row.scanner_run_id));
const scannerArtifacts = scannerArtifactsTable.rows.filter((row) => scannerRunIds.has(row.scanner_run_id));
const markdownProcessor = await createMarkdownProcessor({
  rehypePlugins: [disableMarkdownLinks],
});
const parsedSkillMarkdown = parseFrontmatter(skill.skill_md_content);
const skillFrontmatterRows = flattenFrontmatterRows(parsedSkillMarkdown.frontmatter);
const renderedSkillMarkdown = await markdownProcessor.render(parsedSkillMarkdown.content);

function disableMarkdownLinks() {
  return (tree) => {
    visit(tree, "element", (node) => {
      if (node.tagName !== "a") {
        return;
      }
      node.tagName = "span";
      delete node.properties?.href;
      delete node.properties?.target;
      delete node.properties?.rel;
    });
  };
}

function formatDate(value) {
  if (!value) {
    return "Unknown";
  }
  return new Intl.DateTimeFormat(undefined, {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(new Date(value));
}

function formatFrontmatterValue(value) {
  if (Array.isArray(value)) {
    return value.join(", ");
  }
  return String(value ?? "");
}

function flattenFrontmatterRows(value, prefix = "") {
  if (!value || typeof value !== "object" || Array.isArray(value)) {
    return prefix ? [[prefix, value]] : [];
  }

  return Object.entries(value)
    .flatMap(([key, childValue]) => {
      const rowKey = prefix ? `${prefix}.${key}` : key;
      if (childValue && typeof childValue === "object" && !Array.isArray(childValue)) {
        return flattenFrontmatterRows(childValue, rowKey);
      }
      return [[rowKey, childValue]];
    });
}
---

<BaseLayout title={skill.display_id}>
  <header class="header">
    <p><a href="/">Back to catalog</a></p>
    <h1>{skill.display_id}</h1>
    <p class="muted">{skill.description}</p>
    <p><strong>Recommendation:</strong> <RecommendationBadge recommendation={skill.recommendation} flags={skill.confidence_flags} /></p>
    <div class="metadata-strip">
      <span><strong>Last updated:</strong> {formatDate(skill.last_updated)}</span>
      <span><strong>First observed:</strong> {formatDate(skill.first_observed)}</span>
      {skill.source_url && <a href={skill.source_url}>View source</a>}
      <a href={skill.download_path}>Download zip</a>
    </div>
  </header>

  <section class="tabs">
    <input class="tab-radio" type="radio" id="tab-files" name="detail-tabs" checked />
    <input class="tab-radio" type="radio" id="tab-assessment" name="detail-tabs" />

    <div class="tab-list" role="tablist" aria-label="Skill details">
      <label class="tab-label" id="tab-files-label" for="tab-files" role="tab" aria-controls="panel-files">Files</label>
      <label class="tab-label" id="tab-assessment-label" for="tab-assessment" role="tab" aria-controls="panel-assessment">Assessment</label>
    </div>

    <div class="tab-panels">
      <section class="tab-panel" id="panel-files" role="tabpanel" aria-labelledby="tab-files-label">
        <section class="tabs inner-tabs">
          <input class="tab-radio" type="radio" id="tab-skill-md" name="file-tabs" checked />
          <input class="tab-radio" type="radio" id="tab-file-list" name="file-tabs" />

          <div class="tab-list" role="tablist" aria-label="Skill files">
            <label class="tab-label" id="tab-skill-md-label" for="tab-skill-md" role="tab" aria-controls="panel-skill-md">SKILL.md</label>
            <label class="tab-label" id="tab-file-list-label" for="tab-file-list" role="tab" aria-controls="panel-file-list">File list</label>
          </div>

          <div class="tab-panels">
            <section class="tab-panel" id="panel-skill-md" role="tabpanel" aria-labelledby="tab-skill-md-label">
              <section class="card">
                <h2>SKILL.md</h2>
                {skillFrontmatterRows.length > 0 && (
                  <table class="metadata-table">
                    <thead>
                      <tr>
                        <th>Frontmatter</th>
                        <th>Value</th>
                      </tr>
                    </thead>
                    <tbody>
                      {skillFrontmatterRows.map(([key, value]) => (
                        <tr>
                          <td><code>{key}</code></td>
                          <td>{formatFrontmatterValue(value)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
                <div class="markdown-body" set:html={renderedSkillMarkdown.code} />
              </section>
            </section>

            <section class="tab-panel" id="panel-file-list" role="tabpanel" aria-labelledby="tab-file-list-label">
              <section class="card">
                <h2>Files</h2>
                <ul class="file-list">
                  {skill.skill_files.map((file) => (
                    <li><code>{file.path}</code> <span class="muted">{file.size_bytes} bytes</span></li>
                  ))}
                </ul>
              </section>
            </section>
          </div>
        </section>
      </section>

      <section class="tab-panel" id="panel-assessment" role="tabpanel" aria-labelledby="tab-assessment-label">
        <section class="card">
          <h2>Summary</h2>
          <p><strong>Latest recommendation:</strong> <RecommendationBadge recommendation={skill.recommendation} flags={skill.confidence_flags} /></p>
          <p><strong>Scan mode:</strong> {skill.scan_mode}</p>
          <p><strong>Last scanned:</strong> {formatDate(skill.last_scanned)}</p>
          <p><strong>Content hash:</strong> <code>{skill.content_hash}</code></p>
        </section>
        <ScannerFindings scannerRuns={scannerRuns} scannerFindings={scannerFindings} scannerArtifacts={scannerArtifacts} client:load />
      </section>
    </div>
  </section>
</BaseLayout>
